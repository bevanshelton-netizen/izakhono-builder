{
  "name": "izakhono-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit --target ES2022 --lib ES2022,DOM,DOM.Iterable --module ESNext src/index.ts",
    "deploy:first": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "validate": "npm run typecheck && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "wrangler": "4.127.1"
  }
}
