{
  "version": "2.0.0",
  "name": "IZAKHONO Local Inference Adapter",
  "purpose": "Route supported AI inference only to the IZAKHONO-owned Ollama-compatible local runtime. Deterministic native generation is the fallback.",
  "policy": {
    "execution_mode": "local-only",
    "default_endpoint": "http://127.0.0.1:11434/api/chat",
    "external_inference_allowed": false,
    "api_keys_required": false,
    "artificial_credits": false,
    "deterministic_native_fallback": true,
    "runtime_reachability_must_be_verified": true
  },
  "providers": [
    {
      "id": "ollama-compatible-local",
      "base_url": "http://127.0.0.1:11434/api/chat",
      "env_key": null,
      "capabilities": [
        "text",
        "reasoning",
        "code"
      ],
      "role": "local-inference",
      "free_tier": true,
      "notes": "The endpoint may be overridden only with a private or loopback Ollama-compatible runtime address."
    }
  ],
  "routing_defaults": {
    "text": [
      "ollama-compatible-local"
    ],
    "reasoning": [
      "ollama-compatible-local"
    ],
    "code": [
      "ollama-compatible-local"
    ],
    "vision": [],
    "image": [],
    "audio": [],
    "video": [],
    "pdf": []
  }
}
