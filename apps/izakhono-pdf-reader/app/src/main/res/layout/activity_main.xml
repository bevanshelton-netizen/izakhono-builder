<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="#101817">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IZAKHONO PDF Reader"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/openButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="OPEN PDF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pageInfo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="Open a PDF from WhatsApp or your phone"
        android:textColor="#394B49"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#DCE3E1">
        <ImageView
            android:id="@+id/pageImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="PDF page"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:background="#FFFFFF">
        <Button
            android:id="@+id/previousButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="‹ PREVIOUS" />
        <TextView
            android:layout_width="24dp"
            android:layout_height="1dp" />
        <Button
            android:id="@+id/nextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="NEXT ›" />
    </LinearLayout>
</LinearLayout>
