{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/status",
      "destination": "/external-status.json"
    },
    {
      "source": "/api/v1/catalog",
      "destination": "/curriculum.json"
    },
    {
      "source": "/api/v1/platform",
      "destination": "/platform.json"
    },
    {
      "source": "/api/v1/institutions",
      "destination": "/institutions.json"
    },
    {
      "source": "/api/v1/locales",
      "destination": "/locales.json"
    },
    {
      "source": "/api/v1/offers",
      "destination": "/institutional-offers.json"
    },
    {
      "source": "/api/v1/automation",
      "destination": "/automation.json"
    },
    {
      "source": "/api/v1/assessment-blueprint",
      "destination": "/assessment-blueprint.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
