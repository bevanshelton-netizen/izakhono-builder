{
  "product":"SHELTON FREIGHT",
  "layer":"Security Automation & Response Orchestrator",
  "version":"0.1",
  "purpose":"Convert verified risk intelligence into controlled, auditable operational workflows without inventing emergency capabilities.",
  "principles":["verified_signals_only","least_privilege","human_authorized_control","audit_every_action","offline_resilient","no_fabricated_live_claims"],
  "inputs":["fleet_security_intelligence","risk_engine","FORTRESS","incident_management","journey_intelligence","connectivity_state"],
  "workflow_states":["OBSERVE","CHECK_IN","TRIAGE","ESCALATE","HOLD_OPERATIONS","AUTHORIZED_ASSISTANCE","RESOLVE","CLOSED"],
  "automation_rules":[
    {"condition":"verified_critical","action":"ESCALATE","approval":"operator_or_authorized_policy"},
    {"condition":"driver_distress_plus_security_signal","action":"ESCALATE","approval":"operator_or_authorized_policy"},
    {"condition":"verified_high","action":"TRIAGE","approval":"operator"},
    {"condition":"multiple_verified_watch","action":"CHECK_IN","approval":"policy"},
    {"condition":"unverified_or_demo_only","action":"OBSERVE","approval":"none"},
    {"condition":"missing_live_feed","action":"OBSERVE","approval":"none"}
  ],
  "prohibited_without_authenticated_integration":["emergency_dispatch","police_notification_claim","remote_vehicle_control","remote_engine_control","vehicle_lockdown_claim"],
  "audit":{"required":true,"fields":["action_id","operator_id","vehicle_id","driver_id","journey_id","trigger","decision","timestamp","result"]},
  "production_status":"architecture_ready",
  "live_automation":false
}