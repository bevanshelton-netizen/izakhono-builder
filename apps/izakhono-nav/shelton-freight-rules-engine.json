{
  "product":"SHELTON FREIGHT",
  "layer":"Rules & Decision Engine",
  "version":"0.1",
  "purpose":"Evaluate verified operational events and intelligence into explainable, auditable decisions.",
  "principles":["verified_signals_only","safety_over_commercial_optimization","least_privilege","human_authorized_control","explainable_decisions","audit_every_action","offline_resilient","no_fabricated_live_claims"],
  "inputs":["operations_event_bus","digital_twin","risk_engine","fleet_security_intelligence","vehicle_health","maintenance_workshop","journey_intelligence","delivery_intelligence","customer_experience","revenue_intelligence","corridor_intelligence","connectivity_state"],
  "decision_classes":["SAFETY","SECURITY","OPERATIONS","MAINTENANCE","DELIVERY","CUSTOMER","FINANCIAL","NETWORK"],
  "decision_states":["ACTION_REQUIRED","AUTHORIZE","MONITOR","DELEGATE","INFORMATIONAL","UNAVAILABLE"],
  "priority_order":["SAFETY","SECURITY","OPERATIONS","MAINTENANCE","DELIVERY","CUSTOMER","FINANCIAL","NETWORK"],
  "rules":[
    {"id":"safety-critical","when":"verified critical safety signal","decision":"ACTION_REQUIRED","priority":"SAFETY"},
    {"id":"security-critical","when":"verified critical security signal","decision":"ACTION_REQUIRED","priority":"SECURITY"},
    {"id":"verified-high","when":"verified high-risk signal","decision":"AUTHORIZE","priority":"SAFETY"},
    {"id":"maintenance-grounding","when":"verified safety-critical vehicle condition","decision":"AUTHORIZE","priority":"MAINTENANCE"},
    {"id":"delivery-exception","when":"verified delivery exception","decision":"MONITOR","priority":"DELIVERY"},
    {"id":"commercial-risk","when":"verified financial/customer risk without safety/security conflict","decision":"DELEGATE","priority":"FINANCIAL"},
    {"id":"unverified","when":"signal is unverified, demo, stale or conflicting","decision":"INFORMATIONAL","priority":"OPERATIONS"},
    {"id":"missing-feed","when":"required authenticated input unavailable","decision":"UNAVAILABLE","priority":"OPERATIONS"}
  ],
  "prohibited_without_authenticated_integration":["emergency_dispatch","police_notification_claim","remote_vehicle_control","remote_engine_control","vehicle_lockdown_claim","automatic_driver_discipline","automatic_customer_penalty"],
  "required_audit":["decision_id","rule_id","input_event_ids","verified_status","decision_state","authorized_by","timestamp","outcome"],
  "api":{"evaluate":"POST /api/freight/decision-engine/evaluate","decisions":"GET /api/freight/decision-engine/decisions","actions":"POST /api/freight/decision-engine/actions"},
  "offline":{"enabled":true,"queue":"decision-outbox","replay_on_reconnect":true},
  "production_status":{"architecture_ready":true,"live_decision_automation":false}
}
