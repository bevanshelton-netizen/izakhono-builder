  "hardware_policy": {
    "required_for_core_platform": false,
    "supported_inputs": [
      "smartphone_gps",
      "browser_geolocation",
      "vehicle_telematics_apis",
      "vessel_ais_apis",
      "aviation_data_apis",
      "weather_apis",
      "traffic_apis",
      "port_data_apis",
      "airport_data_apis",
      "enterprise_iot_apis"
