  "common_intelligence": [
    "route_and_corridor_intelligence",
    "safety_intelligence",
    "security_intelligence",
    "weather_and_environmental_context",
    "connectivity_resilience",
    "ai_operations_copilot",
    "FORTRESS_security",
    "event_bus",
    "rules_and_decision_engine",
    "command_automation",
    "audit_and_evidence"
