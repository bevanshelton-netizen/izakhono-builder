{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izakhono.africa/schemas/business-blueprint.json",
  "title": "IZAKHONO Business Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "business", "score", "workflow", "outputs", "status"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "workflow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["IDEA", "BRAND", "WEBSITE", "DOMAIN", "DNS", "SSL", "MAIL", "PAYMENTS", "CRM", "MARKETING", "PROVISIONING"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {
      "type": "string",
      "enum": ["BLUEPRINT_GENERATED", "PROVISIONING_PENDING", "PROVISIONED", "LIVE_VERIFIED"]
    }
  }
}
