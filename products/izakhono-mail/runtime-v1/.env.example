# IZAKHONO MAIL v1 — Stalwart + Roundcube on the shared IZAKHONO HOST edge
MAIL_DOMAIN=izakhono.africa
MAIL_HOSTNAME=mail.izakhono.africa
WEBMAIL_HOSTNAME=webmail.izakhono.africa
TZ=Africa/Johannesburg
MAILBOX=ceo@izakhono.africa

# DNS verification inputs; Stalwart's generated zone file takes precedence.
NODE01_MAIL_MX_HOST=mail.izakhono.africa
NODE01_MAIL_SPF_INCLUDE=
NODE01_MAIL_SPF_IP4=
NODE01_MAIL_DKIM_SELECTOR=
NODE01_MAIL_DKIM_PUBLIC_KEY=
NODE01_MAIL_DMARC_POLICY=none
NODE01_MAIL_DMARC_RUA=postmaster@izakhono.africa

# Set these after the owner completes Stalwart's first-run setup over the loopback-only admin port.
STALWART_JMAP_URL=http://127.0.0.1:18081
STALWART_PROVISIONER_API_KEY=CHANGE_ME_PROVISIONER_API_KEY
STALWART_RECOVERY_ADMIN=admin:CHANGE_ME_RECOVERY_SECRET

# Separate Roundcube database root and application credentials.
ROUNDCUBE_DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
ROUNDCUBE_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Contact address for Caddy/ACME and Stalwart ACME.
ACME_EMAIL=postmaster@izakhono.africa

# Exact selector from Stalwart's generated DKIM zone record; used by acceptance.
DKIM_SELECTOR=

# Required only for encrypted backups. Generate and protect an age recipient/identity pair.
AGE_RECIPIENT=
