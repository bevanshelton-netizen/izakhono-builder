FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    IZAKHONO_MAIL_DB=/app/data/mail.sqlite
COPY products/izakhono-mail/package.json ./package.json
COPY products/izakhono-mail/src ./src
COPY products/izakhono-mail/migrations ./migrations
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 9899
CMD ["node","src/server.mjs"]
