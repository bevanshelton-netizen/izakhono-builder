{
  "name": "izakhono-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs",
    "plan:portfolio": "node src/portfolio-provisioner.mjs",
    "plan:portfolio:legacy": "node scripts/node01-mail-plan.mjs",
    "dns:plan": "node -e \"import('./src/dns-control.mjs').then(m=>{const d=[...new Set(JSON.parse(require('fs').readFileSync('./config/portfolio-identities.json')).identities.map(x=>x.domain).filter(Boolean))]; console.log(JSON.stringify(d.map(m.buildDnsIntent),null,2))})\"",
    "dns:verify": "node src/dns-control.mjs",
    "mailbox:provision": "node src/mailbox-provisioner.mjs"
  }
