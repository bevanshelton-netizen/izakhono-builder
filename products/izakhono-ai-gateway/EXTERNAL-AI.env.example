# IZAKHONO SUPER AI external development route
# COPY THIS FILE OUTSIDE SOURCE CONTROL before entering any real secret.
# Do not commit API keys.

IZAKHONO_AI_OWNER_ONLY=false
IZAKHONO_AI_ALLOW_EXTERNAL=true

# Example: NVIDIA hosted OpenAI-compatible development endpoint.
IZAKHONO_AI_EXTERNAL_TEXT_PROVIDER=nvidia-nim
IZAKHONO_AI_EXTERNAL_TEXT_URL=https://integrate.api.nvidia.com/v1
IZAKHONO_AI_EXTERNAL_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
IZAKHONO_AI_EXTERNAL_TEXT_MODELS=nvidia/nemotron-3-ultra-550b-a55b
IZAKHONO_AI_EXTERNAL_HOSTS=integrate.api.nvidia.com

# Set only in the process environment or an approved local secret store.
IZAKHONO_AI_EXTERNAL_TEXT_API_KEY=

# Existing IZAKHONO internal credentials are also required for end-to-end tests.
IZAKHONO_AI_GATEWAY_INTERNAL_KEY=
IZAKHONO_AI_WORKFLOW_KEY=
IZAKHONO_AI_WORKFLOW_PRODUCTS=izakhono-builder,venture-factory
