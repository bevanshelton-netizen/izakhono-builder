# IZAKHONO SUPER AI owner text runtime pool
# Copy outside source control and replace the example private addresses.
# The order is preference order. Failed runtimes are temporarily cooled down
# and the gateway moves to the next owner-controlled runtime.

IZAKHONO_AI_OWNER_TEXT_URLS=http://127.0.0.1:11434,http://10.0.0.22:11434,http://10.0.0.23:11434
IZAKHONO_AI_OWNER_POOL_COOLDOWN_SECONDS=30
IZAKHONO_AI_OWNER_POOL_MAX=8

# Explicitly list owner-controlled hostnames only when DNS does not resolve
# entirely to loopback/private/link-local addresses.
IZAKHONO_AI_OWNER_HOSTS=127.0.0.1,localhost

# Models remain capability-specific and must exist on the runtimes that may serve them.
IZAKHONO_AI_CHAT_MODEL=qwen3:4b
IZAKHONO_AI_CHAT_MODELS=qwen3:4b
IZAKHONO_AI_REASONING_MODEL=qwen3:4b
IZAKHONO_AI_REASONING_MODELS=qwen3:4b
IZAKHONO_AI_CODE_MODEL=qwen3:4b
IZAKHONO_AI_CODE_MODELS=qwen3:4b

# Gateway-wide admission control. These limits protect owner runtimes from a
# burst of simultaneous expensive requests. Requests beyond the active limit
# wait in the bounded queue; a full or timed-out queue fails closed with a
# retryable capacity_unavailable response.
IZAKHONO_AI_MAX_INFLIGHT=4
IZAKHONO_AI_MAX_QUEUE=16
IZAKHONO_AI_QUEUE_TIMEOUT_SECONDS=20
