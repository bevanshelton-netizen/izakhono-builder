[Unit]
Description=IZAKHONO ID Recovery API
After=network.target izakhono-id.service
Requires=izakhono-id.service

[Service]
Type=simple
User=izakhono
Group=izakhono
WorkingDirectory=/opt/izakhono-id
EnvironmentFile=/etc/izakhono/id.env
Environment=IZAKHONO_ID_RECOVERY_HOST=127.0.0.1
Environment=IZAKHONO_ID_RECOVERY_PORT=9697
ExecStart=/usr/bin/python3 /opt/izakhono-id/recovery_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/izakhono-id

[Install]
WantedBy=multi-user.target
