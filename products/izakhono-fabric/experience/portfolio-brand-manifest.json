{
  "schema": "izakhono.experience.brands.v1",
  "effective_date": "2026-09-25",
  "policy": {
    "preserve_existing_brand_identity": true,
    "no_behavioural_tracking": true,
    "no_advertising_ids": true,
    "no_utm_or_referral_attribution": true,
    "remote_fonts_required": false,
    "international_quality_score": 95,
    "browser_visual_review_required": true,
    "independent_engine_required": true,
    "verified_https_required": true
  },
