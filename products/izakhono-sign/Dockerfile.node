FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    IZAKHONO_SIGN_DB=/app/data/sign.sqlite
COPY products/izakhono-sign/package.json ./package.json
COPY products/izakhono-sign/src ./src
COPY products/izakhono-sign/migrations ./migrations
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 9898
CMD ["node","src/server.mjs"]
