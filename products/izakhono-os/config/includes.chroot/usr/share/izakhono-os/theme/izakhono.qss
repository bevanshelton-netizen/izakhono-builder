QWidget {
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    color: #18212f;
}
QWidget#Shell {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #f8fbff, stop:1 #eef7f4);
}
QFrame#Hero {
    background: rgba(255,255,255,235);
    border: 1px solid #dfe9e6;
    border-radius: 24px;
}
QLabel#Brand {
    color: #0d5f55;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#Title {
    color: #132235;
    font-size: 34px;
    font-weight: 800;
}
QLabel#Subtitle {
    color: #536275;
    font-size: 15px;
}
QLabel#PrivacyBadge {
    color: #0d5f55;
    background: #e6f7f1;
    border: 1px solid #bee8d9;
    border-radius: 14px;
    padding: 8px 12px;
    font-weight: 700;
}
QPushButton {
    text-align: left;
    padding: 18px 20px;
    min-height: 68px;
    border-radius: 18px;
    border: 1px solid #dce7e4;
    background: rgba(255,255,255,245);
    color: #18212f;
    font-size: 16px;
    font-weight: 700;
}
QPushButton:hover {
    border: 1px solid #72b9aa;
    background: #f4fffb;
}
QPushButton:pressed {
    background: #e7f6f1;
}
QPushButton#Primary {
    background: #0d5f55;
    color: white;
    border: 1px solid #0d5f55;
    text-align: center;
}
QPushButton#Primary:hover {
    background: #117466;
}
QPushButton#DangerFree {
    background: #f5fbff;
    border: 1px solid #cfe4f3;
}
QLineEdit {
    min-height: 48px;
    border-radius: 16px;
    border: 1px solid #d9e5e2;
    padding: 0 16px;
    background: white;
    font-size: 15px;
}
QLineEdit:focus {
    border: 2px solid #72b9aa;
}
QFrame#Panel {
    background: rgba(255,255,255,240);
    border: 1px solid #dfe9e6;
    border-radius: 20px;
}
QLabel#StatusGood {
    color: #0b6a4f;
    font-weight: 800;
}
QLabel#Muted {
    color: #647487;
}
