#!/usr/bin/env python3
import os
import sys
from pathlib import Path

from PyQt6.QtCore import Qt
from PyQt6.QtGui import QFont
from PyQt6.QtWidgets import (
    QApplication,
    QLabel,
    QMessageBox,
    QPushButton,
    QVBoxLayout,
    QWidget,
)

MARKER = Path.home() / ".config" / "izakhono-os" / "welcome-complete"

class Welcome(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to IZAKHONO OS")
        self.setMinimumSize(760, 520)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(42, 36, 42, 36)
        layout.setSpacing(20)

        title = QLabel("Welcome to IZAKHONO OS")
        title.setFont(QFont("", 30, 700))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        tagline = QLabel("Your computer. Made simple. No tracking.")
        tagline.setFont(QFont("", 17))
        tagline.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(tagline)

        body = QLabel(
            "You can try IZAKHONO OS without changing your existing files.\n\n"
            "Start with the Easy Center for Internet, Files, Apps, Settings, Updates and Help.\n\n"
            "IZAKHONO OS does not require a cloud account for basic use and does not add behavioural tracking."
        )
        body.setWordWrap(True)
        body.setFont(QFont("", 14))
        layout.addWidget(body)

        privacy = QPushButton("🔒 Read the Privacy Promise")
        privacy.setMinimumHeight(58)
        privacy.clicked.connect(self.show_privacy)
        layout.addWidget(privacy)

        migration = QPushButton("📦 Moving from another computer?")
        migration.setMinimumHeight(58)
        migration.clicked.connect(self.show_migration)
        layout.addWidget(migration)

        start = QPushButton("Start using IZAKHONO OS")
        start.setMinimumHeight(64)
        start.setFont(QFont("", 15, 700))
        start.clicked.connect(self.finish)
        layout.addWidget(start)

    def show_privacy(self):
        QMessageBox.information(
            self,
            "Privacy Promise",
            "IZAKHONO OS itself does not track you.\n\n"
            "No behavioural telemetry. No advertising ID. No profiling. No silent analytics."
        )

    def show_migration(self):
        QMessageBox.information(
            self,
            "Migration",
            "The migration assistant is being built to copy your documents, pictures, music and supported browser data without deleting the originals.\n\n"
            "The current alpha does not perform destructive migration actions."
        )

    def finish(self):
        MARKER.parent.mkdir(parents=True, exist_ok=True)
        MARKER.write_text("complete\n", encoding="utf-8")
        self.close()

def main():
    if MARKER.exists():
        return
    app = QApplication(sys.argv)
    app.setApplicationName("IZAKHONO Welcome")
    window = Welcome()
    window.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
