#!/usr/bin/env python3
import argparse
import json
import os
import socket

ACTIONS = ("system.status", "apps.list", "privacy.status", "migration.preview", "updates.status", "help.topics")

def main():
    parser = argparse.ArgumentParser(description="IZAKHONO OS local engine")
    parser.add_argument("action", choices=ACTIONS)
    args = parser.parse_args()
    path = os.environ.get("IZAKHONO_OS_ENGINE_SOCKET", "/run/izakhono-engine/engine.sock")
    payload = json.dumps({"action": args.action, "params": {}}).encode("utf-8") + b"\\n"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(3)
        client.connect(path)
        client.sendall(payload)
        response = b""
        while not response.endswith(b"\\n"):
            chunk = client.recv(4096)
            if not chunk:
                break
            response += chunk
    print(json.dumps(json.loads(response.decode("utf-8")), indent=2))

if __name__ == "__main__":
    main()
