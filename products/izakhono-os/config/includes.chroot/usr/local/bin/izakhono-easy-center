def system_language():
    tag = locale.getlocale()[0] or "en"
    code = tag.split("_")[0].lower()
    return code if code in TRANSLATIONS else "en"

def read_style():
    try:
        return QSS.read_text(encoding="utf-8")
    except OSError:
        return ""

LANG = system_language()
T = TRANSLATIONS[LANG]

ACTIONS = [
    ("internet", ["firefox-esr"]),
    ("files", ["dolphin"]),
    ("apps", ["plasma-discover"]),
    ("settings", ["systemsettings"]),
    ("updates", ["plasma-discover", "--mode", "Update"]),
    ("move", ["izakhono-migrate"]),
    ("privacy", ["izakhono-privacy-center"]),
]

def launch(command):
    if not shutil.which(command[0]):
        QMessageBox.warning(None, "Not available", f"{command[0]} is not available in this build yet.")
        return
    subprocess.Popen(command, start_new_session=True)

class EasyCenter(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("Shell")
        self.setWindowTitle("IZAKHONO OS — Easy Center")
        self.setMinimumSize(960, 720)
        if LANG == "ar":
            self.setLayoutDirection(Qt.LayoutDirection.RightToLeft)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(38, 32, 38, 30)
        outer.setSpacing(18)

        top = QHBoxLayout()
        brand = QLabel("IZAKHONO OS")
        brand.setObjectName("Brand")
        top.addWidget(brand)
        top.addStretch()
        privacy_badge = QLabel("🔒  NO TRACKING")
        privacy_badge.setObjectName("PrivacyBadge")
        top.addWidget(privacy_badge)
        outer.addLayout(top)

        hero = QFrame()
        hero.setObjectName("Hero")
        hero_layout = QVBoxLayout(hero)
        hero_layout.setContentsMargins(30, 26, 30, 26)
        hero_layout.setSpacing(9)

        title = QLabel(T["title"])
        title.setObjectName("Title")
        hero_layout.addWidget(title)

        subtitle = QLabel(T["subtitle"])
        subtitle.setObjectName("Subtitle")
        hero_layout.addWidget(subtitle)

        self.search = QLineEdit()
        self.search.setPlaceholderText(T["search"])
        self.search.returnPressed.connect(self.run_search)
        hero_layout.addWidget(self.search)
        outer.addWidget(hero)

        grid = QGridLayout()
        grid.setSpacing(14)
        for i, (key, command) in enumerate(ACTIONS[:6]):
            button = QPushButton(T[key])
            if key == "move":
                button.setObjectName("DangerFree")
            button.clicked.connect(lambda checked=False, c=command: launch(c))
            grid.addWidget(button, i // 2, i % 2)

        help_button = QPushButton(T["help"])
        help_button.clicked.connect(self.help_me)
        grid.addWidget(help_button, 3, 0)

        privacy_button = QPushButton(T["privacy"])
        privacy_button.clicked.connect(lambda: launch(["izakhono-privacy-center"]))
        grid.addWidget(privacy_button, 3, 1)
        outer.addLayout(grid)

        footer = QLabel(T["footer"])
        footer.setObjectName("Muted")
        footer.setWordWrap(True)
        footer.setAlignment(Qt.AlignmentFlag.AlignCenter)
        outer.addWidget(footer)

    def run_search(self):
        q = self.search.text().strip().lower()
        if not q:
            return
        mapping = [
            (("wifi", "wi-fi", "internet", "browser", "web"), ["firefox-esr"]),
            (("file", "document", "picture", "photo", "folder"), ["dolphin"]),
            (("app", "software", "install"), ["plasma-discover"]),
            (("setting", "display", "sound", "bluetooth", "printer"), ["systemsettings"]),
            (("update", "upgrade"), ["plasma-discover", "--mode", "Update"]),
            (("privacy", "tracking", "telemetry"), ["izakhono-privacy-center"]),
            (("move", "migrate", "windows", "transfer", "import"), ["izakhono-migrate"]),
        ]
        for words, command in mapping:
            if any(word in q for word in words):
                launch(command)
                return
        self.help_me(q)

    def help_me(self, question=""):
        prompt = f"\n\nYou asked: {question}" if question else ""
        QMessageBox.information(
            self,
            "Help Me",
            "Ask IZAKHONO is being built as a safe plain-language assistant." + prompt +
            "\n\nIn this Alpha it stays local, sends no prompts to a cloud service, "
            "and cannot execute arbitrary system commands."
        )

app = QApplication(sys.argv)
app.setApplicationName("IZAKHONO Easy Center")
app.setStyleSheet(read_style())
center = EasyCenter()
center.show()
sys.exit(app.exec())
