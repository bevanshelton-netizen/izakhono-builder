def system_language():
    tag = locale.getlocale()[0] or "en"
    code = tag.split("_")[0].lower()
    return code if code in TRANSLATIONS else "en"

LANG = system_language()
T = TRANSLATIONS[LANG]

APPS = [
    (T["internet"], ["firefox-esr"]),
    (T["files"], ["dolphin"]),
    (T["apps"], ["plasma-discover"]),
    (T["settings"], ["systemsettings"]),
    (T["updates"], ["plasma-discover", "--mode", "Update"]),
]

def launch(command):
    if not shutil.which(command[0]):
        QMessageBox.warning(None, "Not available", f"{command[0]} is not available in this build yet.")
        return
    subprocess.Popen(command, start_new_session=True)

class EasyCenter(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("IZAKHONO OS — Easy Center")
        self.setMinimumSize(860, 620)
        if LANG == "ar":
            self.setLayoutDirection(Qt.LayoutDirection.RightToLeft)

        outer = QVBoxLayout(self)
        outer.setContentsMargins(36, 30, 36, 30)
        outer.setSpacing(18)

        title = QLabel(T["title"])
        title.setFont(QFont("", 28, 700))
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        outer.addWidget(title)

        subtitle = QLabel(T["subtitle"])
        subtitle.setFont(QFont("", 14))
        subtitle.setAlignment(Qt.AlignmentFlag.AlignCenter)
        outer.addWidget(subtitle)

        grid = QGridLayout()
        grid.setSpacing(16)

        for i, (label, command) in enumerate(APPS):
            button = QPushButton(label)
            button.setMinimumHeight(96)
            button.setFont(QFont("", 17, 600))
            button.clicked.connect(lambda checked=False, c=command: launch(c))
            grid.addWidget(button, i // 2, i % 2)

        help_button = QPushButton(T["help"])
        help_button.setMinimumHeight(96)
        help_button.setFont(QFont("", 17, 600))
        help_button.clicked.connect(self.help_me)
        grid.addWidget(help_button, 2, 1)

        privacy_button = QPushButton(T["privacy"])
        privacy_button.setMinimumHeight(96)
        privacy_button.setFont(QFont("", 17, 600))
        privacy_button.clicked.connect(self.privacy)
        grid.addWidget(privacy_button, 3, 0, 1, 2)

        outer.addLayout(grid)

        footer = QLabel(T["footer"])
        footer.setWordWrap(True)
        footer.setAlignment(Qt.AlignmentFlag.AlignCenter)
        outer.addWidget(footer)

    def help_me(self):
        QMessageBox.information(
            self,
            "Help Me",
            "Ask IZAKHONO will become a safe plain-language assistant.\n\n"
            "This alpha does not send prompts or diagnostics to a cloud service and does not execute arbitrary system commands."
        )

    def privacy(self):
        QMessageBox.information(
            self,
            "IZAKHONO Privacy Guarantee",
            "IZAKHONO OS itself does not track you.\n\n"
            "• No behavioural telemetry\n"
            "• No advertising ID\n"
            "• No profiling\n"
            "• No silent analytics\n"
            "• No automatic crash upload\n\n"
            "Websites, internet providers and independently installed apps are outside the OS guarantee."
        )

app = QApplication(sys.argv)
app.setApplicationName("IZAKHONO Easy Center")
center = EasyCenter()
center.show()
sys.exit(app.exec())
