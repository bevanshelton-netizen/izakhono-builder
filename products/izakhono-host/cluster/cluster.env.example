# IZAKHONO OWNED CLUSTER — copy to each node as needed.
# Do not commit populated credentials or real public addresses.
# NODE_ROLE must be one of: CONTROL, EDGE, DNS, RUNTIME, DATA, MAIL, BACKUP, FORTRESS.
NODE_ROLE=CONTROL
NODE_NAME=NODE01

# Comma-separated logical node names. Resolve these through your private/public DNS.
IZAKHONO_NODES=NODE01,NODE02,NODE03

# Control-plane endpoint used by workers/automation.
CONTROL_PLANE_URL=http://NODE01:8080

# Shared authentication token for internal control-plane calls.
CONTROL_PLANE_TOKEN=replace-with-long-random-token

# Public addresses are intentionally configured at deployment time; never invent them here.
OWNED_EDGE_IPV4=
OWNED_EDGE_IPV6=
OWNED_EDGE_HOSTNAME=

# Optional backup target. Use an IZAKHONO-owned storage endpoint where available.
BACKUP_TARGET=
