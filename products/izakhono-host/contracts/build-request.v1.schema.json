{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.izakhono.local/host/build-request.v1.schema.json",
  "title": "IZAKHONO HOST Build Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "source_repository_id",
    "source_commit_sha",
    "manifest_digest",
    "build_profile",
    "resource_class",
    "network_policy_id",
    "artifact_policy_id",
    "requested_by",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "izakhono.host.build-request.v1" },
    "request_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "project_id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "source_repository_id": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$" },
    "source_commit_sha": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "build_profile": { "type": "string", "enum": ["node-web-v1", "static-site-v1"] },
    "resource_class": { "type": "string", "enum": ["build-small", "build-medium", "build-large"] },
    "network_policy_id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "artifact_policy_id": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" },
    "requested_by": { "type": "string", "minLength": 1, "maxLength": 160 },
    "expires_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "minLength": 8, "maxLength": 128 }
  }
}
