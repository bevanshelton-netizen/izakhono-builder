# Copy to kora.env and populate from the approved FORTRESS secret source.
# Never commit kora.env. NEXT_PUBLIC_* values are public and are also supplied
# as build arguments from the HOST .env file before the image is built.

NEXT_PUBLIC_APP_NAME=KORA
NEXT_PUBLIC_APP_URL=https://streamkoraafrica.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_KORA_DB_SCHEMA=kora

# Server-only credentials. Never place these in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
VIDEO_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

KORA_INTERNAL_API_SECRET=
KORA_PAYMENT_ORCHESTRATOR=direct
IZAKHONO_PAY_URL=
IZAKHONO_PAY_API_KEY=
IZAKHONO_PAY_WEBHOOK_SECRET=
KORA_IZAKHONO_PAY_LIVE_APPROVED=false
KORA_PAYMENT_PRODUCTION_VERIFIED=false
KORA_TICKET_CHECKOUT_MODE=off
KORA_TICKET_LIVE_APPROVED=false

NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_RIGHTS_EMAIL=

KORA_CONTENT_RIGHTS_VERIFIED=false
KORA_LEGAL_APPROVED=false
KORA_REGULATORY_APPROVED=false
KORA_CHILD_SAFETY_APPROVED=false
KORA_PAYOUT_OPERATIONS_APPROVED=false
KORA_BACKUP_OPERATIONS_APPROVED=false
KORA_INCIDENT_RESPONSE_APPROVED=false
KORA_PUBLIC_DEPLOYMENT_VERIFIED=false
KORA_PRIVATE_SIGNUP_ENABLED=false
