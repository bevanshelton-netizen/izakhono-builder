{
  email {$TLS_EMAIL}
  admin :2019
  on_demand_tls {
    ask http://host-runtime:8080/api/tls/ask
  }
}

:80 {
  redir https://{host}{uri} permanent
}

mail.izakhonoafrica.co.za, autoconfig.izakhonoafrica.co.za, autodiscover.izakhonoafrica.co.za {
  tls {
    on_demand
  }
  reverse_proxy {$STALWART_HTTP_UPSTREAM}
}

mail-admin.izakhonoafrica.co.za {
  tls {
    on_demand
  }
  basic_auth {
    {$MAIL_ADMIN_USER} {$MAIL_ADMIN_PASSWORD_HASH}
  }
  handle /api/* {
    reverse_proxy mail-control-plane:8000 {
      header_up Authorization "Bearer {$CONTROL_PLANE_TOKEN}"
    }
  }
  handle {
    root * /srv/mail-admin
    file_server
  }
}

mta-sts.izakhonoafrica.co.za {
  tls {
    on_demand
  }
  root * /srv/mta-sts
  file_server
}

webmail.izakhonoafrica.co.za {
  tls {
    on_demand
  }
  reverse_proxy roundcube:80
}

:443 {
  tls {
    on_demand
  }
  @contact path /api/contact
  handle @contact {
    reverse_proxy contact-gateway:8090
  }
  handle {
    reverse_proxy host-runtime:8080
  }
}
