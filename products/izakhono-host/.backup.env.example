# Restic encrypted off-host backup credentials. Never commit the populated .backup.env.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_S3_ENDPOINT/izakhono-host-backups
RESTIC_PASSWORD=REPLACE_WITH_LONG_UNIQUE_RESTIC_REPOSITORY_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET_KEY
