# Copy to .env on NODE01. Never commit the populated file.
HOST_RUNTIME_TOKEN=replace-with-a-long-random-token
TLS_EMAIL=ops@example.com
POSTGRES_DB=izakhono
POSTGRES_USER=izakhono
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=izakhono-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Owned contact gateway -> IZAKHONO MAIL. Keep the token server-side only.
IZAKHONO_MAIL_API_URL=http://mail-bridge:8091
IZAKHONO_MAIL_API_TOKEN=replace-with-a-long-random-token

# Owned mail server / SMTP transport.
STALWART_PUBLIC_URL=https://mail.example.com
STALWART_RECOVERY_ADMIN=admin:replace-with-a-long-random-password
SMTP_HOST=stalwart
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USER=info@example.com
SMTP_PASS=replace-with-the-mailbox-password

# Mail acceptance / diagnostic settings.
MAIL_DOMAIN=example.com
MAIL_FROM=info@example.com
MAIL_TO=info@example.com
DKIM_SELECTOR=

# IZAKHONO Compute Fabric — generate unique random values for both tokens.
COMPUTE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
COMPUTE_WORKER_TOKEN=replace-with-a-different-long-random-worker-token
COMPUTE_LEASE_MS=120000
COMPUTE_WORKER_ID=izakhono-worker-01
COMPUTE_WORKER_POLL_MS=3000

# PostgreSQL-backed durable compute queue (same owned HOST database).
# The manager uses a transactional row lock for multi-manager-safe job leases.
