# Copy to .env on the owner-controlled host. Never commit the populated file.
HOST_RUNTIME_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASSWORD_HASH=REPLACE_WITH_CADDY_BCRYPT_HASH
TLS_EMAIL=bevans@izakhonoafrica.co.za
POSTGRES_DB=izakhono
POSTGRES_USER=izakhono
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DATABASE_PASSWORD
MINIO_ROOT_USER=izakhono-admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_MINIO_PASSWORD

# Platform hostnames allowed to receive on-demand TLS certificates.
PLATFORM_TLS_HOSTS=mail.izakhonoafrica.co.za,webmail.izakhonoafrica.co.za,autoconfig.izakhonoafrica.co.za,autodiscover.izakhonoafrica.co.za,mta-sts.izakhonoafrica.co.za,mail-admin.izakhonoafrica.co.za
STALWART_HTTP_UPSTREAM=http://stalwart:8080

# Owned contact gateway -> IZAKHONO MAIL. Keep this token server-side only.
IZAKHONO_MAIL_API_URL=http://mail-bridge:8091
IZAKHONO_MAIL_API_TOKEN=REPLACE_WITH_LONG_RANDOM_MAIL_BRIDGE_TOKEN

# Stalwart mail server. Use local for co-located Stalwart or remote for a dedicated mail node.
MAIL_MODE=local
# For a separate mail node, set SMTP_HOST and STALWART_HTTP_UPSTREAM to its private VPN address.
STALWART_PUBLIC_URL=https://mail.izakhonoafrica.co.za
STALWART_RECOVERY_ADMIN=admin:REPLACE_WITH_UNIQUE_STALWART_RECOVERY_PASSWORD
STALWART_API_URL=http://stalwart:8080
STALWART_API_KEY=REPLACE_WITH_LEAST_PRIVILEGE_STALWART_API_TOKEN
MAIL_NODE_BIND_IP=127.0.0.1
MAIL_NODE_PRIVATE_IP=host-gateway

# Application mail uses a dedicated notification mailbox, not the CEO mailbox.
SMTP_HOST=stalwart
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USER=notifications@izakhonoafrica.co.za
SMTP_PASS=REPLACE_WITH_NOTIFICATIONS_MAILBOX_PASSWORD

# Internal mailbox control plane. Generate a separate token and Fernet key.
CONTROL_PLANE_TOKEN=REPLACE_WITH_SEPARATE_LONG_RANDOM_TOKEN
MAIL_HANDOVER_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
MAIL_ALLOWED_DOMAINS=izakhonoafrica.co.za
MAIL_DOMAIN_VERIFICATION_TTL_SECONDS=604800

# Initial domain acceptance checks. DKIM_SELECTOR must match the selector generated by Stalwart.
MAIL_DOMAIN=izakhonoafrica.co.za
MAIL_HOST=mail.izakhonoafrica.co.za
MAIL_PUBLIC_IP=REPLACE_WITH_STATIC_PUBLIC_IPV4
MAIL_TEST_ADDRESS=bevans@izakhonoafrica.co.za
MAIL_FROM=notifications@izakhonoafrica.co.za
MAIL_TO=bevans@izakhonoafrica.co.za
DKIM_SELECTOR=REPLACE_AFTER_STALWART_GENERATES_DKIM
