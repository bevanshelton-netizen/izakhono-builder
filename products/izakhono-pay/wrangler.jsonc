{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "izakhono-pay-v1",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "d1_databases": [
    {"binding":"DB","database_name":"izakhono-pay-sandbox","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}
  ],
  "vars": {"APP_ENV":"sandbox"}
}
