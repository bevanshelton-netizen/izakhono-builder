{
  // Sandbox proof configuration; production remains fail-closed.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "izakhono-pay-sandbox",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izakhono-pay-sandbox",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "sandbox",
    "PAYMENT_MODE": "sandbox",
    "PAYSTACK_ENABLED": "false",
    "PAYFAST_ENABLED": "true",
    "PAYFAST_SANDBOX": "true",
    "PAYFAST_REQUIRE_IP": "true",
    "MERCHANT_WEBHOOK_ALLOWED_HOSTS": ""
  }
}
