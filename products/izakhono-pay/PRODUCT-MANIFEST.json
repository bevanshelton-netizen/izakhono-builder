{
  "product": "IZAKHONO PAY",
  "version": "1.1-control-plane",
  "category": "business-money-operating-system",
  "positioning": "African Business Money Operating System",
  "principles": ["owned-first", "interoperable", "idempotent", "auditable", "provider-replaceable", "regulated-partner-boundaries"],
  "states": ["initiated", "pending", "authorised", "failed", "reversed", "refunded", "settled", "disputed"],
  "modules": {
    "payments": ["payment_intents", "public_checkout", "payment_links", "refunds", "webhooks"],
    "ledger": ["events", "settlements", "fees", "reconciliation", "exceptions"],
    "merchant": ["onboarding", "summary", "transactions", "merchant_console"],
    "commerce": ["customers", "products", "orders", "invoices", "receipts"],
    "automation": ["rules", "notifications", "reminders", "ai_actions"],
    "trust": ["merchant_kyb", "fortress", "audit", "risk_events"],
    "developer": ["api_keys", "sandbox", "idempotency", "events", "provider_adapter_contract", "sdk_contract"]
  },
  "routes": [
    "GET /health",
    "GET /pay/:token",
    "POST /v1/public/payment-links/:token/intent",
    "POST /v1/merchants",
    "GET /v1/merchants/:id",
    "GET /v1/merchants/:id/summary",
    "GET /v1/merchants/:id/transactions",
    "POST /v1/payment-intents",
    "GET /v1/payment-intents/:id",
    "POST /v1/payment-links",
    "POST /v1/refunds",
    "POST /v1/reconciliation/settlements",
    "POST /v1/webhooks/:provider"
  ],
  "provider_adapter": {
    "interface": ["create_payment", "get_payment", "refund_payment", "verify_webhook"],
    "policy": "providers are replaceable capacity adapters"
  },
  "regulatory_boundary": {
    "izakhono_owns": ["software", "merchant_experience", "orchestration", "control_plane", "ledger_metadata", "analytics"],
    "regulated_partner_handles_until_authorised": ["funds_custody", "clearing", "settlement", "regulated_acquiring", "regulated_issuing", "e_money"]
  },
  "launch_sequence": [
    "merchant onboarding",
    "payment links",
    "public checkout",
    "payment intents",
    "webhook event bus",
    "ledger",
    "settlement reconciliation",
    "merchant dashboard",
    "provider adapter",
    "controlled pilot merchants"
  ]
}
