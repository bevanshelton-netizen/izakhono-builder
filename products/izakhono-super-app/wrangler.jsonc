{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izakhono-super-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
