{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izakhono-super-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izakhono-builder",
      "database_id": "a59d44af-22cc-4967-8b00-03c817d7a7dd"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
