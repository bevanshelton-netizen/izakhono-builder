# IZAKHONO-owned edge configuration for I-CONNECT.
# Replace the host with the approved production hostname before activation.
{$I_CONNECT_HOST} {
    encode zstd gzip
    reverse_proxy i-connect:3000
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
