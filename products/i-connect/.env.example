# I-CONNECT production configuration
# NEVER commit real secrets. Configure these in the deployment platform.

I_CONNECT_SUPABASE_URL=
I_CONNECT_SUPABASE_ANON_KEY=
I_CONNECT_CARRIER_BRIDGE_URL=
I_CONNECT_CARRIER_BRIDGE_SECRET=
I_CONNECT_PAYMENT_PROVIDER_SECRET=

# Server-side workflow worker. Keep the service-role key private and never expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=
I_CONNECT_WORKER_ENABLED=false

# One-time owner bootstrap only. Remove these after provisioning; never commit real values.
I_CONNECT_BOOTSTRAP_ORG_SLUG=izakhono
I_CONNECT_OWNER_EMAIL=
I_CONNECT_OWNER_PASSWORD=
I_CONNECT_CONFIRM_OWNER_BOOTSTRAP=NO

# Meta WhatsApp webhook intake (disabled until a verified channel is connected).
I_CONNECT_WHATSAPP_WEBHOOK_ENABLED=false
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
