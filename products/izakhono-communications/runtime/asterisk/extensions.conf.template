; IZAKHONO Communications OS - controlled internal dialplan

[izakhono-internal]
; Extension-to-extension calls are deliberately constrained to the
; Communications OS managed extension namespace.
exten => _1XXX,1,Dial(PJSIP/${EXTEN},30)
exten => _1XXX,n,Hangup()

; Generated tenant routes are loaded separately so the static safety baseline
; remains reviewable and the control plane can reconcile managed state.
#include extensions.d/*.conf

; No unrestricted PSTN pattern is provided here. Outbound PSTN routing must
; be generated by the Communications OS policy engine after carrier,
; entitlement, fraud and emergency-call policy checks.
