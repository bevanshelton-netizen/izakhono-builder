{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izakhono-booking",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izakhono-booking",
      "database_id": "REPLACE_WITH_OWNED_D1_DATABASE_ID"
    }
  ]
}
