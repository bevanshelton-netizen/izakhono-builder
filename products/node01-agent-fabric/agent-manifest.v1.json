{
  "schema": "izakhono.node01-agent-fabric/v1",
  "version": "0.2.0",
  "orchestrator": "node01",
  "agent_count": 25,
  "domains": ["research", "business", "build", "security", "operations", "governance"],
  "scaling_target": 150,
  "control_plane": ["ai.gateway", "queue", "observe", "mail", "provisioner"],
  "execution": {
    "parallel": true,
    "fail_closed": true,
    "provider_neutral": true,
    "model_required_for_core": false,
    "external_adapters": "explicit-boundary"
  },
  "production_gates": [
    "owned-runtime-evidence",
    "health-check",
    "rollback-proof",
    "https-tls-dns-verification",
    "public-live-evidence"
  ]
}
