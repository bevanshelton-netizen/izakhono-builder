FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    IZAKHONO_FLOWIQ_DB=/app/data/flowiq.sqlite
COPY products/izakhono-flowiq/package.json ./package.json
COPY products/izakhono-flowiq/src ./src
COPY products/izakhono-flowiq/migrations ./migrations
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 9797
CMD ["node","src/server.mjs"]
