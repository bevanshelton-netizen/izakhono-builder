# FORTRESS provider configuration
# MOCK_MODE must remain true until production gates are approved.
FORTRESS_MOCK_MODE=true

# OpenSanctions — commercial licence required for commercial screening.
OPENSANCTIONS_API_URL=https://api.opensanctions.org
OPENSANCTIONS_API_TOKEN=

# VerifyNow — credentials supplied only after commercial agreement/onboarding.
VERIFYNOW_API_URL=
VERIFYNOW_API_KEY=

# CIPC — credentials supplied only after approved API onboarding.
CIPC_API_URL=https://api.cipc.co.za
CIPC_CLIENT_ID=
CIPC_CLIENT_SECRET=

# Runtime/security placeholders
FORTRESS_DATABASE_URL=
FORTRESS_ENCRYPTION_KEY=
FORTRESS_AUDIT_SALT=
