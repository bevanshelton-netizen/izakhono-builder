# NODE 01 owned runtime environment template.
# Copy this file to .env.owned on NODE 01 and replace placeholders locally.
# Never commit real credentials.

NODE_ENV=production
PORT=8781
HOST=0.0.0.0

# Backend-only Supabase connection. Keep the service-role key off clients.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_ONLY_SERVICE_ROLE_KEY

# Internal owned service bridges.
IZAKHONO_BUILDER_INTERNAL_URL=http://izakhono-builder:8780
IZAKHONO_FLOW_INTERNAL_URL=http://izakhono-flow:8794
