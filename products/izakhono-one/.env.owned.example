# NODE 01 owned runtime environment template.
# Copy this file to .env.owned on NODE 01 and replace placeholders locally.
# Never commit real credentials.

NODE_ENV=production
PORT=8781
HOST=0.0.0.0

# Backend-only Supabase connection. Keep the service-role key off clients.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_BACKEND_ONLY_SERVICE_ROLE_KEY

# Internal owned service bridges.
IZAKHONO_BUILDER_INTERNAL_URL=http://izakhono-builder:8780
IZAKHONO_FLOW_INTERNAL_URL=http://izakhono-flow:8794

# ONE AI chat uses the approved IZAKHONO local model runtime only.
# Keep the model endpoint private; remote hosts must use HTTPS and be allowlisted.
IZAKHONO_LOCAL_MODEL_URL=http://127.0.0.1:11434/api/chat
IZAKHONO_LOCAL_MODEL=qwen2.5-coder:3b
IZAKHONO_MODEL_TRUSTED_HOSTS=
# Optional backend-only bearer secret for an authenticated owner-hosted endpoint.
IZAKHONO_LOCAL_MODEL_SECRET=
