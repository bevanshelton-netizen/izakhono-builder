    "external_networks": "replaceable adapters only"
  },
  "operating_modes": {
    "publisher": {
      "description": "Earn commission from approved third-party offers.",
      "enabled": true
    },
    "izakhono_network": {
      "description": "Allow approved partners to earn commission on qualifying IZAKHONO sales.",
      "enabled": true,
      "default_commission_rate": null,
      "commission_policy": "product-specific rate must be configured from verified margin and budget authority"
    }
  },
