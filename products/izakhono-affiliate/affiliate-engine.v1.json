  "autonomy": {
    "automatic": [
      "discover_public_program_changes",
      "ingest_approved_offer_feeds",
      "score_offer_relevance",
      "generate_subids_and_tracking_links",
      "route_approved_creative_to_distribution",
      "reconcile_click_conversion_commission_events",
      "detect_suspicious_referral_patterns",
      "sync_verified_financial_events_to_accounting",
      "sync partner and lead records to CRM",
      "pause broken or policy-invalid adapters",
      "produce exception-only owner reporting"
    ],
    "requires_owner_or_authorised_officer": [
      "accept_network_legal_terms",
      "submit banking_or_tax_identity_data",
      "authorise_paid_media_spend",
      "set_or_change commission rates with material financial impact",
      "release disputed or exceptional payouts"
    ]
  },
  "tracking": {
    "subid_attribution": true,
    "first_party_event_ledger": true,
    "behavioural_profiling": false,
    "advertising_ids": false,
    "raw_prompt_persistence": false,
    "consent_and_disclosure_required": true
  },
  "payouts": {
    "verified_conversion_required": true,
    "hold_for_reversal_window": true,
    "fraud_clearance_required": true,
    "accounting_reconciliation_required": true
  },
  "launch_policy": {
    "public_live_claim_requires_verified_https": true,
    "adapter_live_claim_requires_successful_authenticated_test": true,
    "no_external_adapter_may_become_system_of_record": true
  },
  "super_app_module": {
    "schema": "izakhono.super-app.module.v1",
    "module_id": "affiliate",
    "surface": "IZAKHONO SUPER APP",
    "route": "/affiliate",
    "embedded": true,
    "engine": "independent",
    "canonical_contract": "products/izakhono-affiliate/affiliate-engine.v1.json"
