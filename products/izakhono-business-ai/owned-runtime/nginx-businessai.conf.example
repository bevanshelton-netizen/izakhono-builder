# IZAKHONO EDGE/TLS example only.
# Keep certificate management in the existing IZAKHONO EDGE/TLS layer.
# Do not expose port 8787 directly to the public internet.

upstream izakhono_business_ai {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name businessai.izakhono.co.za;

    # ssl_certificate /path/managed/by/izakhono-edge/fullchain.pem;
    # ssl_certificate_key /path/managed/by/izakhono-edge/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://izakhono_business_ai;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
