# YHVH GOSPEL TV production runtime
# Copy to .env on the private broadcast host. NEVER commit real secrets.
NODE_ENV=production
YHVH_TERRITORY=ZA
YHVH_CONTENT_VAULT=/app/content-vault
YHVH_HLS_DIR=/app/hls
YHVH_CONTROL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional authorized distribution endpoint. Keep credentials in the secret store.
# YHVH_RTMP_URL=rtmps://example.invalid/live/STREAM_KEY
