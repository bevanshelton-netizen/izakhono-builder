# Copy to .env on the private broadcast host. Never commit the real file.
YHVH_CONTROL_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
YHVH_BROADCAST_TERRITORY=ZA
YHVH_SUPERVISOR_ENABLED=true
YHVH_SUPERVISOR_INTERVAL_MS=30000

# Optional: authorized external RTMP destination. Keep the credential in the host secret store.
# YHVH_RTMP_URL=rtmps://AUTHORIZED_PROVIDER/live/STREAM_KEY
