FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY products/izakhono-docflow/package.json ./package.json
RUN npm install --no-audit --no-fund
COPY products/izakhono-docflow/src ./src
RUN npm run build:node

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    APP_ENV=production \
    IZAKHONO_DOCFLOW_DB=/app/data/docflow.sqlite
COPY products/izakhono-docflow/package.json ./package.json
COPY --from=build /build/dist ./dist
COPY products/izakhono-docflow/src/node-server.mjs ./src/node-server.mjs
COPY products/izakhono-docflow/public ./public
COPY products/izakhono-docflow/migrations ./migrations
RUN mkdir -p /app/data && chown -R node:node /app
USER node
EXPOSE 8787
CMD ["node","src/node-server.mjs"]
