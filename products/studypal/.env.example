NODE_ENV=development
PORT=3000

# IZAKHONO-owned backend services
STUDYPAL_DATABASE_URL=
STUDYPAL_AUTH_ISSUER=
STUDYPAL_AUTH_AUDIENCE=
STUDYPAL_STORAGE_ENDPOINT=

# Provider adapters
STUDYPAL_AI_PROVIDER=
STUDYPAL_PAYMENT_PROVIDER=izakhono-pay

# Bootstrap-only owner provisioning secret.
# Never expose this to browsers or commit a real value.
STUDYPAL_OWNER_BOOTSTRAP_TOKEN=
