{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izakhono-isbn-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "izakhono-isbn-registry",
      "database_id": "REPLACE_WITH_APPROVED_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
