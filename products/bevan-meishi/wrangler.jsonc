{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bevan-meishi",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_LIVE": "false"
  }
}
