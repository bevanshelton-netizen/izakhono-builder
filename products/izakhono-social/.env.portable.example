# CONNECTA ENGINE portable deployment
PORT=4100
DATABASE_URL=postgres://connecta:replace-me@postgres:5432/connecta
CONNECTA_OWNER_KEY=replace-with-a-long-random-owner-secret

# Engine identity
CONNECTA_ENGINE_VERSION=0.2.0
CONNECTA_ENGINE_INSTANCE=portable-01

# Database startup / migration
CONNECTA_DB_STARTUP_RETRIES=30
CONNECTA_DB_STARTUP_RETRY_MS=2000
DB_POOL_SIZE=10

# Privacy / application controls
ALLOWED_ORIGINS=
SESSION_DAYS=30
REGISTER_RATE_LIMIT=8
MAX_JSON_BYTES=1000000
MAX_MEDIA_BYTES=26214400

# Storage: local (default) or s3
CONNECTA_STORAGE_DRIVER=local
MEDIA_ROOT=/var/lib/connecta/media

# S3-compatible adapter (used only when CONNECTA_STORAGE_DRIVER=s3)
CONNECTA_S3_ENDPOINT=
CONNECTA_S3_REGION=us-east-1
CONNECTA_S3_BUCKET=
CONNECTA_S3_PREFIX=connecta-media
CONNECTA_S3_ACCESS_KEY_ID=
CONNECTA_S3_SECRET_ACCESS_KEY=
CONNECTA_S3_FORCE_PATH_STYLE=
