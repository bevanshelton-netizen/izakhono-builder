# CONNECTA owned compose environment
# Copy to /etc/izakhono/apps/connecta.env on NODE01 and set real secret values.
CONNECTA_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
CONNECTA_OWNER_KEY=REPLACE_WITH_LONG_RANDOM_OWNER_SECRET
CONNECTA_ALLOWED_ORIGINS=
CONNECTA_PORT=3080
CONNECTA_REGISTER_RATE_LIMIT=8

# External Next.js resilience route only:
# Set CONNECTA_ENGINE_URL to an approved HTTPS CONNECTA ENGINE endpoint.
# Never place database passwords or owner keys in browser-visible variables.
# CONNECTA_ENGINE_URL=https://connecta-engine.example.com
