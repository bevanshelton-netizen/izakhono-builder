[Unit]
Description=IZAKHONO SHORTS owned renderer
After=network.target izakhono-comfyui.service
Wants=izakhono-comfyui.service

[Service]
Type=simple
EnvironmentFile=/etc/izakhono/apps/izakhono-shorts-renderer.env
WorkingDirectory=/opt/izakhono-shorts-renderer
ExecStart=/usr/bin/python3 /opt/izakhono-shorts-renderer/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/izakhono/shorts

[Install]
WantedBy=multi-user.target
