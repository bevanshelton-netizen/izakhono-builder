{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izakhono.example/contracts/stream/hls-v1.json",
  "title": "IZAKHONO STREAM HLS Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenantId", "assetId", "profile", "masterPlaylistUri", "renditions", "authorization", "validation"],
  "properties": {
    "tenantId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["VOD", "LINEAR"] },
    "masterPlaylistUri": { "type": "string", "format": "uri" },
    "renditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "playlistUri", "codec", "bitrateKbps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "playlistUri": { "type": "string", "format": "uri" },
          "codec": { "type": "string", "minLength": 1 },
          "bitrateKbps": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mode"],
      "properties": {
        "required": { "type": "boolean" },
        "mode": { "enum": ["SIGNED_URL", "PLAYBACK_TOKEN", "NONE"] }
      }
    },
    "drm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "systems": {
          "type": "array",
          "items": { "enum": ["WIDEVINE", "FAIRPLAY", "PLAYREADY"] },
          "uniqueItems": true
        },
        "licenseProviderRef": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masterExists", "renditionCount", "tenantMatch", "assetMatch"],
      "properties": {
        "masterExists": { "type": "boolean" },
        "renditionCount": { "type": "integer", "minimum": 1 },
        "tenantMatch": { "type": "boolean" },
        "assetMatch": { "type": "boolean" },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
