PORT=8080
IZ_DATA_DIR=/var/lib/izakhono-containers

# Required for operator actions such as builds and deployments.
# Generate with: openssl rand -hex 32
IZ_ADMIN_TOKEN=change-me

# Shared first-generation node enrollment secret.
# Replace later with per-node mTLS identities.
IZ_NODE_ENROLL_TOKEN=change-me-too

# Registry credentials are supplied through registry/auth/htpasswd.
