{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://izakhono.example/schemas/ai-workforce/evidence-contracts-v1.schema.json",
  "title": "IZAKHONO AI Workforce Evidence Contracts v1",
  "description": "Proposed transport-neutral JSON contracts. The example namespace is not a deployed endpoint or registered public schema identifier.",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value",
        "profile_ref"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_ref": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "evidence_object_id",
        "object_version_id",
        "content_digest",
        "reference_purpose",
        "classification"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "evidence_object_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "object_version_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "reference_purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "request_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_record_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "source_version": {
          "$ref": "#/$defs/opaqueId"
        }
      }
    },
    "resolveRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "correlation_id",
        "tenant_id",
        "evidence_object_id",
        "object_version_id",
        "action",
        "purpose",
        "response_mode"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId",
          "description": "Consistency assertion only; authoritative tenant is derived from verified identity."
        },
        "evidence_object_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "object_version_id": {
          "$ref": "#/$defs/opaqueId",
          "description": "Exact immutable version. No latest alias or mutable locator."
        },
        "action": {
          "const": "READ"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "response_mode": {
          "enum": [
            "METADATA",
            "CONTENT_STREAM"
          ]
        },
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "request_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_manifest_id": {
          "$ref": "#/$defs/opaqueId"
        }
      },
      "dependentRequired": {
        "operation_id": [
          "request_fingerprint"
        ],
        "request_fingerprint": [
          "operation_id"
        ]
      }
    },
    "resolveResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "request_id",
        "correlation_id",
        "tenant_id",
        "evidence_object_id",
        "object_version_id",
        "content_digest",
        "content_length_bytes",
        "classification",
        "verified_at",
        "audit_reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "PENDING",
            "UNKNOWN",
            "REJECTED"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "correlation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "evidence_object_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "object_version_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "content_length_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "audit_reference": {
          "$ref": "#/$defs/opaqueId"
        },
        "provenance_reference": {
          "$ref": "#/$defs/opaqueId"
        },
        "delivery_mode": {
          "enum": [
            "NONE",
            "CONTENT_STREAM"
          ]
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema_id",
        "manifest_schema_version",
        "manifest_id",
        "tenant_id",
        "operation_id",
        "request_fingerprint",
        "created_at",
        "created_by",
        "canonicalization_profile_ref",
        "entries",
        "entry_count",
        "total_content_length_bytes",
        "manifest_digest",
        "retention_class_ref"
      ],
      "properties": {
        "manifest_schema_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifest_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "manifest_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "tenant_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "operation_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "request_fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "$ref": "#/$defs/opaqueId"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/opaqueId"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_content_length_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "signing_identity_ref": {
          "$ref": "#/$defs/opaqueId"
        },
        "signature_ref": {
          "$ref": "#/$defs/opaqueId"
        },
        "retention_class_ref": {
          "$ref": "#/$defs/opaqueId"
        },
        "legal_hold_state": {
          "enum": [
            "NONE",
            "ACTIVE",
            "REVIEW_REQUIRED"
          ]
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/resolveRequest"
    },
    {
      "$ref": "#/$defs/resolveResponse"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/evidenceReference"
    }
  ]
}
