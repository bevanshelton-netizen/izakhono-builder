HOSTING_NODE_PORT=8787
IZAKHONO_NODE_ID=replace-with-unique-node-id
IZAKHONO_RELEASE_TOKEN=replace-with-long-random-token
IZAKHONO_PUBLIC_BASE_URL=https://host.example.com
IZAKHONO_CONTROL_PLANE_URL=https://control-plane.example.com
IZAKHONO_NODE_KEY=replace-with-node-registration-key
IZAKHONO_HEARTBEAT_MS=60000
IZAKHONO_RELEASE_ROOT=/var/lib/izakhono-node/releases
IZAKHONO_MAX_ARTIFACT_BYTES=104857600
IZAKHONO_MAX_EXTRACTED_FILES=5000
IZAKHONO_HEALTH_TIMEOUT_MS=120000
IZAKHONO_HEALTH_INTERVAL_MS=1000
IZAKHONO_RELEASE_BASE_PORT=19000
IZAKHONO_MAX_CONCURRENT_RELEASES=1
IZAKHONO_ALLOW_HTTP_ARTIFACTS=false
