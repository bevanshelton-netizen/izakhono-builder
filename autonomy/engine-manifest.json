{
  "schema": "izakhono.autonomy/v1",
  "mode": "continuous",
  "policy": {
    "autoAdvance": true,
    "maxRetries": 3,
    "productionClaimsRequireEvidence": true,
    "infrastructureStrategy": "software-first",
    "softwareFirstReplacement": true,
    "nodeFirst": true,
    "externalInfrastructureIsFallback": true,
    "ownerGates": ["credentials", "financial_authorization", "physical_infrastructure", "security_exception"]
  },
  "principles": [
    "Eliminate hardware dependency when software can legitimately replace, abstract, virtualize, consolidate, or automate it.",
    "Use software-defined infrastructure before adding physical hardware.",
    "When physical hardware remains necessary, prefer IZAKHONO NODES.",
    "Treat external infrastructure as reversible fallback or temporary extension, not the assumed foundation.",
    "Never claim production readiness without verifiable evidence.",
    "Prefer independent ready work over a single blocking dependency."
  ],
  "stages": ["planning", "architecture", "design", "development", "integration", "testing", "security", "deployment", "verification", "documentation", "monetisation", "launch", "handover"],
  "adapters": {
    "builder": ["hercules", "local-agent", "manual"],
    "code": ["github", "izakhono-code"],
    "deploy": ["izakhono-node", "vercel"],
    "data": ["izakhono-data", "supabase"],
    "dns": ["izakhono-edge", "cloudflare"],
    "mail": ["izakhono-mail", "mailcow"],
    "payments": ["izakhono-pay", "ikhokha", "payfast"],
    "security": ["fortress"],
    "observe": ["izakhono-observe", "vercel"]
  },
  "queue": [
    {"id": "platform-foundation", "title": "Keep the IZAKHONO execution control plane continuously buildable", "stage": "architecture", "adapter": "code", "dependsOn": [], "action": "validate-manifest", "evidence": ["manifest-valid"]},
    {"id": "continuous-worker", "title": "Run the next dependency-ready task automatically", "stage": "development", "adapter": "code", "dependsOn": ["platform-foundation"], "action": "run-worker", "evidence": ["worker-exit-zero"]},
    {"id": "builder-bridge", "title": "Connect an application-builder adapter so approved builds can continue without manual NEXT prompts", "stage": "integration", "adapter": "builder", "dependsOn": ["continuous-worker"], "action": "adapter-contract", "evidence": ["adapter-contract-valid"], "ownerGate": "builder-connection"},
    {"id": "node-discovery", "title": "Discover and authenticate the IZAKHONO NODE runtime", "stage": "integration", "adapter": "deploy", "dependsOn": ["continuous-worker"], "action": "node-discovery", "evidence": ["node-reachable", "node-authenticated"], "ownerGate": "physical-infrastructure"},
    {"id": "node-heartbeat", "title": "Emit a continuous machine-readable IZAKHONO NODE health and capacity heartbeat", "stage": "verification", "adapter": "deploy", "dependsOn": ["continuous-worker"], "action": "node-heartbeat", "evidence": ["heartbeat-emitted", "node-health-readable", "capacity-reported"], "ownerGate": "physical-infrastructure"},
    {"id": "node-target-selection", "title": "Select the healthiest eligible IZAKHONO NODE before deployment promotion", "stage": "verification", "adapter": "deploy", "dependsOn": ["node-heartbeat"], "action": "node-target", "requirements": {"requiredChecks": ["nodeReachable", "persistentStorageReady", "containerRuntimeReady", "monitoringOnline"]}, "evidence": ["eligible-node-selected"], "ownerGate": "physical-infrastructure"},
    {"id": "owned-node-promotion", "title": "Promote continuous execution from hosted heartbeat to IZAKHONO NODE/QUEUE", "stage": "deployment", "adapter": "deploy", "dependsOn": ["continuous-worker", "node-discovery", "node-heartbeat", "node-target-selection"], "action": "node-readiness", "requirements": {"requiredChecks": ["nodeReachable", "persistentStorageReady", "containerRuntimeReady", "monitoringOnline"]}, "evidence": ["container-runtime-ready", "persistent-storage-ready", "backup-tested", "security-gate-passed", "monitoring-online"], "ownerGate": "physical-infrastructure"}
  ]
}
