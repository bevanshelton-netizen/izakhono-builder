{
  "schema": "izakhono.autonomy/v1",
  "mode": "continuous",
  "policy": {
    "autoAdvance": true,
    "maxRetries": 3,
    "productionClaimsRequireEvidence": true,
    "ownerGates": ["credentials", "financial_authorization", "physical_infrastructure", "security_exception"]
  },
  "stages": [
    "planning",
    "architecture",
    "design",
    "development",
    "integration",
    "testing",
    "security",
    "deployment",
    "verification",
    "documentation",
    "monetisation",
    "launch",
    "handover"
  ],
  "adapters": {
    "builder": ["hercules", "local-agent", "manual"],
    "code": ["github", "izakhono-code"],
    "deploy": ["izakhono-node", "vercel"],
    "data": ["izakhono-data", "supabase"],
    "dns": ["izakhono-edge", "cloudflare"],
    "mail": ["izakhono-mail", "mailcow"],
    "payments": ["izakhono-pay", "ikhokha", "payfast"],
    "security": ["fortress"],
    "observe": ["izakhono-observe", "vercel"]
  },
  "queue": [
    {
      "id": "platform-foundation",
      "title": "Keep the IZAKHONO execution control plane continuously buildable",
      "stage": "architecture",
      "adapter": "code",
      "dependsOn": [],
      "action": "validate-manifest",
      "evidence": ["manifest-valid"]
    },
    {
      "id": "continuous-worker",
      "title": "Run the next dependency-ready task automatically",
      "stage": "development",
      "adapter": "code",
      "dependsOn": ["platform-foundation"],
      "action": "run-worker",
      "evidence": ["worker-exit-zero"]
    },
    {
      "id": "builder-bridge",
      "title": "Connect an application-builder adapter so approved builds can continue without manual NEXT prompts",
      "stage": "integration",
      "adapter": "builder",
      "dependsOn": ["continuous-worker"],
      "action": "adapter-contract",
      "evidence": ["adapter-contract-valid"],
      "ownerGate": "builder-connection"
    },
    {
      "id": "node-discovery",
      "title": "Discover and authenticate the IZAKHONO NODE runtime",
      "stage": "integration",
      "adapter": "deploy",
      "dependsOn": ["continuous-worker"],
      "action": "node-discovery",
      "evidence": ["node-reachable", "node-authenticated"],
      "ownerGate": "physical-infrastructure"
    },
    {
      "id": "owned-node-promotion",
      "title": "Promote continuous execution from hosted heartbeat to IZAKHONO NODE/QUEUE",
      "stage": "deployment",
      "adapter": "deploy",
      "dependsOn": ["continuous-worker", "node-discovery"],
      "action": "node-readiness",
      "evidence": ["container-runtime-ready", "persistent-storage-ready", "backup-tested", "security-gate-passed", "monitoring-online"],
      "ownerGate": "physical-infrastructure"
    }
  ]
}
