# Copy to /etc/izakhono/node-cluster.env on each node.
# Never commit the populated file.

IZAKHONO_CLUSTER_NAME=izakhono-production
IZAKHONO_TIMEZONE=Africa/Johannesburg

NODE01_NAME=node01
NODE01_IP=10.20.0.11
NODE02_NAME=node02
NODE02_IP=10.20.0.12
NODE03_NAME=node03
NODE03_IP=10.20.0.13
NODE04_NAME=node04
NODE04_IP=10.20.0.14

# Set to the NODE 01 private address during initial bootstrap.
K3S_PRIMARY_URL=https://10.20.0.11:6443

# Populate on NODE 02-04 only, from:
# sudo cat /var/lib/rancher/k3s/server/node-token
K3S_TOKEN=

# Optional encrypted backup target.
# Good first production pattern: NODE 04 exposes an owner-only SFTP repository.
# Example: sftp:backup@10.20.0.14:/srv/izakhono-backups/restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/izakhono/restic-password

# Local persistent application data root.
IZAKHONO_DATA_ROOT=/srv/izakhono
