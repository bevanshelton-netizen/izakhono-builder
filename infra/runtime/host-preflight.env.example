# Runtime host preflight configuration. Never commit secrets here.
# NODE01-NODE04 are logical software/runtime identities, not machines.
IZAKHONO_NODE_ID=NODE01
IZAKHONO_RUNTIME_HOST_NAME=izakhono-runtime-01
IZAKHONO_STATE_ROOT=/opt/izakhono
IZAKHONO_EDGE_NETWORK=izakhono-edge
IZAKHONO_RELEASE_ADAPTER=/opt/izakhono/bin/izakhono-release
IZAKHONO_EVIDENCE_DIR=/opt/izakhono/state/runtime-host
