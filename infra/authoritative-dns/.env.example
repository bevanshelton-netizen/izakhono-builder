# Never commit a real .env file.
DNS_MODE=primary
PDNS_API_ENABLED=yes
PDNS_API_KEY=CHANGE_ME_LONG_RANDOM_SECRET
PRIMARY_NS_FQDN=ns1.allegrovibez.com
SECONDARY_NS_FQDN=ns2.allegrovibez.com
PRIMARY_PUBLIC_IPV4=CHANGE_ME_PRIMARY_PUBLIC_IPV4
SECONDARY_PUBLIC_IPV4=CHANGE_ME_SECONDARY_PUBLIC_IPV4

# Registrar cutover is intentionally manual and is not automated by this stack.
# Keep the existing MX/TXT records intact until a full zone inventory has been verified.
