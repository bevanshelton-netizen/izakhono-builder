{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IZAKHONO Worker Handoff Contract v1",
  "type": "object",
  "required": ["api_version", "job", "from", "to", "state", "artifact", "acceptance", "evidence", "failure_route"],
  "properties": {
    "api_version": { "const": "izakhono.worker-handoff/v1" },
    "job": {
      "type": "object",
      "required": ["id", "application", "run_id"],
      "properties": {
        "id": { "type": "string", "minLength": 8 },
        "application": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["READY", "IN_PROGRESS", "PASSED", "FAILED", "BLOCKED", "ROLLED_BACK"]
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "version", "location"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_route": {
      "type": "object",
      "required": ["owner", "action"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      }
    }
  }
}
