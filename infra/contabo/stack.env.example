# Pin every runtime image to a registry-verified sha256 digest before deployment.
# Replace each suffix below with the exact 64-character digest for the selected release.
POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:REPLACE_WITH_VERIFIED_DIGEST
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
QDRANT_IMAGE=qdrant/qdrant:v1@sha256:REPLACE_WITH_VERIFIED_DIGEST
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v1@sha256:REPLACE_WITH_VERIFIED_DIGEST

POSTGRES_DB=izakhono
POSTGRES_USER=izakhono
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
WEBUI_SECRET_KEY=CHANGE_ME_64_HEX_SECRET
OPEN_WEBUI_PORT=3000

# Optional external model endpoints; keep API keys outside Git.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=
