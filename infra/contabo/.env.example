# Contabo OAuth credentials - NEVER commit real values
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# Contabo account/resource settings
CONTABO_REGION=EU
CONTABO_IMAGE_ID=
CONTABO_SSH_KEY_IDS=
CONTABO_PERIOD=1

# IZAKHONO runtime binding
# NODE01-NODE04 are logical software/runtime identities, not physical servers.
IZAKHONO_NODE_ID=NODE01
# This is the current infrastructure host name. It may change without changing NODE01.
IZAKHONO_RUNTIME_HOST_NAME=izakhono-runtime-01
IZAKHONO_RELEASE_VERSION=0.1.0
IZAKHONO_RELEASE_ID=local-build
IZAKHONO_SCHEMA_VERSION=1

# Optional public domain used only after EDGE/DNS is approved
IZAKHONO_HEALTH_DOMAIN=
