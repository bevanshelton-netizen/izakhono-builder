{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IZAKHONO Runtime Control Plane State",
  "type": "object",
  "required": ["schemaVersion", "release", "target", "state", "evidence", "updatedAt"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "release": {
      "type": "object",
      "required": ["product", "version", "buildId", "schemaVersion"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "buildId": {"type": "string", "minLength": 1},
        "schemaVersion": {"type": "string", "minLength": 1},
        "checksum": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["nodeId", "provider", "routeClass"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "routeClass": {"enum": ["owned", "external-resilience", "external-auxiliary"]}
      },
      "additionalProperties": false
    },
    "state": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["releaseApproved", "health", "deployment", "edge", "tls", "dns", "smokeTest", "rollbackReady"],
      "properties": {
        "releaseApproved": {"type": "boolean"},
        "health": {"type": "boolean"},
        "deployment": {"type": "boolean"},
        "edge": {"type": "boolean"},
        "tls": {"type": "boolean"},
        "dns": {"type": "boolean"},
        "smokeTest": {"type": "boolean"},
        "rollbackReady": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
